{
    "name": "ft-backend",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file .env src/main.ts",
        "build": "tsc",
        "start": "node dist/main.js",
        "test": "vitest --config vitest.config.ts --run",
        "e2e": "vitest --config vitest.config.ts --run",
        "db:generate:global": "drizzle-kit generate --config=drizzle.global.config.ts",
        "db:generate:regional": "drizzle-kit generate --config=drizzle.regional.config.ts",
        "db:migrate:all": "tsx scripts/migrate-all.ts",
        "openapi:gen": "tsx --env-file .env src/gen-openapi.ts",
        "openapi:client": "openapi-ts -i ./openapi.json -o ./e2e/client",
        "lint": "eslint",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1111.0",
        "@aws-sdk/s3-presigned-post": "^3.1111.0",
        "@aws-sdk/s3-request-presigner": "^3.1111.0",
        "@hono/node-server": "^2.0.12",
        "@hono/zod-openapi": "^1.5.1",
        "@scalar/hono-api-reference": "^0.11.12",
        "@types/ms": "^2.1.0",
        "argon2": "^0.45.1",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^1.0.0-rc.4",
        "hono": "^4.12.32",
        "pino": "^10.3.1",
        "postgres": "^3.4.9",
        "uuid": "^14.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@hey-api/openapi-ts": "^0.99.0",
        "@testcontainers/postgresql": "^12.0.4",
        "@types/node": "^24.13.3",
        "@types/uuid": "^10.0.0",
        "drizzle-kit": "^1.0.0-rc.4",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.8.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.6",
        "testcontainers": "^12.0.4",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
