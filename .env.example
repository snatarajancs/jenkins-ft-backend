# ── Database ─────────────────────────────────────────────────────
# Global database connection string.
GLOBAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ft_global

# JSON array of per-region configurations.
# regionId: positive integer identifying the region.
# dbUrl:    connection string to the region's database.
# s3Bucket: S3 bucket name for profile images in this region.
# awsRegion: AWS region identifier (e.g. ap-south-1, eu-west-2).
# awsEndpoint: (optional) custom S3 endpoint for this region.
REGION_CONFIGS=[{"regionId":1,"dbUrl":"postgresql://postgres:postgres@localhost:5432/ft_region_1","s3Bucket":"profile-files-r1","awsRegion":"ap-south-1"},{"regionId":2,"dbUrl":"postgresql://postgres:postgres@localhost:5432/ft_region_2","s3Bucket":"profile-files-r2","awsRegion":"eu-west-2"}]

# ── JWT ──────────────────────────────────────────────────────────
# Secret key used to sign and verify JWTs (must be at least 32 characters).
JWT_SECRET=super-secret-key-that-is-at-least-32-chars!!

# Access token expiry duration (ms format: e.g. "15 min", "1 hr", "7 days").
JWT_ACCESS_EXPIRY=15 min

# Refresh token expiry duration.
JWT_REFRESH_EXPIRY=1 day

# ── S3 / MinIO ───────────────────────────────────────────────────
# Default AWS region for global S3 operations.
AWS_REGION=us-east-1
# Access key for S3-compatible storage.
AWS_ACCESS_KEY_ID=minioadmin
# Secret key for S3-compatible storage.
AWS_SECRET_ACCESS_KEY=minioadmin
# Custom endpoint URL (set to MinIO URL for local development).
AWS_ENDPOINT_URL=http://localhost:9000

# ── CORS ────────────────────────────────────────────────────────
#Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=

# ── Debug ────────────────────────────────────────────────────────
# When true, enables debug-only endpoints (e.g. /api/auth/debug/reset).
ENABLE_DEBUG_ENDPOINTS=true
