{
  "schema_version": "1.0",

  "project": {
    "name": "jenkins-pipeline-poc-github-app",
    "type": "service"
  },

  "components": {

    "contract": {
      "language": "nodejs",
      "runtime": "22",
      "source": "contract",

      "build": {
        "tool": "npm"
      }
    },

    "server": {
      "language": "nodejs",
      "runtime": "22",
      "source": "server",

      "depends_on": [
        "contract"
      ],

      "build": {
        "tool": "npm"
      },

      "testing": {
        "enabled": true
      },

      "container": {
        "repository": "jenkins-pipeline-poc-github-app/server",
        "dockerfile": "Dockerfile",
        "context": "."
      },

      "deployment": {
        "target": "ecs",
        "strategy": "rolling"
      }
    },

    "backend": {
      "language": "go",
      "framework": "gin",
      "runtime": "1.24",
      "source": ".",

      "build": {
        "tool": "go",
        "artifact_directory": "bin"
      },

      "testing": {
        "enabled": true
      }
    },

    "frontend": {
      "language": "nodejs",
      "framework": "react",
      "runtime": "22",
      "source": "web",

      "build": {
        "tool": "npm",
        "artifact_directory": "dist"
      },

      "testing": {
        "enabled": true
      }
    },

    "e2e": {
      "language": "nodejs",
      "runtime": "22",
      "source": "backend/e2e",

      "build": {
        "tool": "npm"
      },

      "testing": {
        "enabled": true
      }
    }
  }
}